<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="jinasena_mrp_repair_form_bom_limit" model="ir.ui.view">
        <field name="name">mrp.repair.form.bom.limit</field>
        <field name="model">mrp.repair</field>
        <field name="inherit_id" ref="repair.mrp_repair_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="allowed_component_ids" invisible="1" />
                <field name="show_no_bom_info" invisible="1" />
                <div class="alert alert-info" attrs="{'invisible': [('show_no_bom_info','=',False)]}">
                    <span>
                        No BoM found for the selected product. Add lines are restricted until a BoM is defined.
                    </span>
                </div>
            </xpath>

            <xpath expr="//field[@name='operations']/tree//field[@name='product_id']" position="attributes">
                <attribute name="domain">[("id", "in", parent.allowed_component_ids)]</attribute>
            </xpath>
            <xpath expr="//field[@name='operations']/form//field[@name='product_id']" position="attributes">
                <attribute name="domain">[("id", "in", parent.allowed_component_ids)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
